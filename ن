<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Noor 💌</title>
<link href="https://fonts.googleapis.com/css2?family=Parisienne&family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0710;--bg2:#1a0d1f;--rose:#e0466f;--rose2:#ff8fab;--gold:#e8c9a0;--paper:#f6e9ea;--ink:#3a1a26;--card:#20122a;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box;margin:0}
html{height:100%}
body{-webkit-user-select:none;user-select:none;min-height:100%;background:radial-gradient(ellipse at 50% 30%,var(--bg2),var(--bg) 70%);color:var(--paper);font-family:'Aref Ruqaa',Georgia,'Times New Roman',serif;overflow-x:hidden}
.script{font-family:'Parisienne','Brush Script MT',cursive;direction:ltr}
#stars,#hearts{position:fixed;inset:0;pointer-events:none;overflow:hidden}
.heart-f{position:absolute;bottom:-40px;color:var(--rose);opacity:.5;animation:rise linear forwards}
@keyframes rise{to{transform:translateY(-110vh) rotate(25deg);opacity:0}}

/* ENVELOPE SCREEN */
#intro{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:34px;padding:20px;transition:opacity .8s,transform .8s}
#intro.gone{opacity:0;transform:scale(1.2);pointer-events:none;position:absolute;inset:0}
.env{position:relative;width:min(320px,82vw);aspect-ratio:1.5;cursor:pointer;filter:drop-shadow(0 20px 40px rgba(224,70,111,.35));animation:float 3s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-10px)}}
.env .back{position:absolute;inset:0;background:#b53a5c;border-radius:8px}
.env .letter{position:absolute;left:8%;right:8%;top:6%;height:80%;background:var(--paper);border-radius:6px;transition:transform .9s .4s;z-index:1}
.env .front{position:absolute;inset:0;z-index:2;border-radius:8px;background:
 linear-gradient(to bottom right,transparent 49.5%,#c9456a 50%) left/50% 100% no-repeat,
 linear-gradient(to bottom left,transparent 49.5%,#d4527a 50%) right/50% 100% no-repeat;}
.env .front::after{content:"";position:absolute;left:0;right:0;bottom:0;height:55%;background:linear-gradient(#e0587f,#c43f66);clip-path:polygon(0 100%,50% 0,100% 100%);opacity:.0}
.env .flap{position:absolute;left:0;right:0;top:0;height:58%;background:linear-gradient(#e2557b,#c8446a);clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:top;transition:transform .7s;z-index:3}
.name{position:absolute;z-index:4;left:0;right:0;top:14%;text-align:center;font-size:clamp(34px,10vw,50px);color:var(--gold);text-shadow:0 2px 6px rgba(0,0,0,.4);transition:opacity .4s}
.seal{position:absolute;z-index:5;left:50%;top:58%;translate:-50% -50%;width:58px;height:58px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ff7a9c,#b81f4b);display:grid;place-items:center;font-size:28px;box-shadow:0 4px 12px rgba(0,0,0,.5);animation:beat 1.4s infinite;transition:opacity .4s}
@keyframes beat{0%,100%{scale:1}50%{scale:1.15}}
.env.open{animation:none}
.env.open .flap{transform:rotateX(180deg);z-index:0}
.env.open .letter{transform:translateY(-70%)}
.env.open .seal,.env.open .name{opacity:0}
.hint{font-size:1.35rem;color:var(--rose2);letter-spacing:.5px;animation:pulse 2s infinite}
@keyframes pulse{50%{opacity:.4}}

/* MAIN */
#main{display:none;position:relative;padding:60px 18px 80px;max-width:1000px;margin:auto}
#main.show{display:block;animation:fade 1.4s}
@keyframes fade{from{opacity:0;transform:translateY(30px)}}
.hero{text-align:center;margin-bottom:50px}
.hero h1{font-size:clamp(56px,16vw,110px);font-weight:400;color:var(--rose2);text-shadow:0 0 30px rgba(224,70,111,.6)}
.hero p{font-size:1.4rem;color:var(--gold);margin-top:6px}
.divider{margin:14px auto;color:var(--rose);letter-spacing:10px}
.msg{background:linear-gradient(145deg,var(--card),#2a1430);border:1px solid rgba(232,201,160,.25);border-radius:18px;padding:28px 24px;text-align:center;font-size:1.3rem;line-height:2.2;margin:0 auto 56px;max-width:640px;box-shadow:0 10px 40px rgba(0,0,0,.4)}
h2{text-align:center;font-weight:400;font-size:1.9rem;color:var(--gold);margin-bottom:26px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:26px;margin-bottom:56px}
.frame{background:var(--paper);padding:12px 12px 12px;border-radius:4px;box-shadow:0 12px 30px rgba(0,0,0,.6);transition:transform .4s;color:var(--ink)}
.frame:nth-child(odd){transform:rotate(-2.5deg)}.frame:nth-child(even){transform:rotate(2deg)}
.frame:hover{transform:rotate(0) scale(1.04);z-index:2}
.slot{position:relative;aspect-ratio:3/4;background:linear-gradient(135deg,#3b1f3a,#26122c);display:grid;place-items:center;overflow:hidden;color:var(--rose2);text-align:center}
.slot span{font-size:1rem;padding:10px}.slot b{display:block;font-size:2.4rem;font-weight:400}
.slot img,.slot video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 30%;background:#000}
.slot input{display:none}
.cap{margin-top:8px;text-align:center;font-size:1.15rem;outline:none;min-height:1.6em}
.wide{grid-column:1/-1}
.wide .slot{aspect-ratio:16/8}
.foot{text-align:center;font-size:1.9rem;color:var(--rose2)}
.foot .script{font-size:2.6rem;display:block;margin-top:8px;color:var(--gold)}
.tip{text-align:center;font-size:.95rem;opacity:.55;margin-bottom:24px}

.counter{text-align:center;margin:0 auto 60px;max-width:700px}
.counter .t{font-size:1.5rem;color:var(--rose2);margin-bottom:6px}
.counter .d{font-size:1rem;color:var(--gold);opacity:.8;margin-bottom:22px}
.units{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
@media(min-width:640px){.units{grid-template-columns:repeat(6,1fr)}}
.u{background:linear-gradient(145deg,var(--card),#2a1430);border:1px solid rgba(255,143,171,.35);border-radius:16px;padding:16px 4px 12px;box-shadow:0 0 22px rgba(224,70,111,.25);animation:glow 3s ease-in-out infinite}
.u:nth-child(even){animation-delay:1.5s}
@keyframes glow{50%{box-shadow:0 0 34px rgba(255,143,171,.5)}}
.u b{display:block;font-size:2.1rem;font-weight:700;color:var(--paper);font-variant-numeric:tabular-nums}
.u span{font-size:1.05rem;color:var(--rose2)}
.counter .hh{margin-top:18px;color:var(--rose);font-size:1.4rem;animation:beat 1.4s infinite}

html{overflow-x:hidden;-webkit-text-size-adjust:100%;-webkit-tap-highlight-color:transparent}
#intro{min-height:100vh;min-height:100dvh}

@media(max-width:600px){
  #main{padding:36px 14px 60px}
  .hero{margin-bottom:34px}
  .hero p{font-size:1.2rem}
  .msg{font-size:1.15rem;padding:22px 16px;margin-bottom:40px;border-radius:16px}
  .counter{margin-bottom:44px}
  .counter .t{font-size:1.25rem}
  .units{gap:8px}
  .u{padding:12px 2px 9px;border-radius:12px}
  .u b{font-size:1.7rem}
  .u span{font-size:.95rem}
  h2{font-size:1.6rem;margin-bottom:20px}
  .grid{grid-template-columns:1fr;gap:26px;margin-bottom:44px}
  .frame{width:100%;max-width:340px;margin:0 auto}
  .frame:nth-child(odd){transform:rotate(-1.5deg)}
  .frame:nth-child(even){transform:rotate(1.5deg)}
  .foot{font-size:1.5rem}
  .hint{font-size:1.2rem}
}
@media(hover:none){.frame:hover{transform:none}}
</style>
</head>
<body>
<div id="hearts"></div>

<section id="intro">
  <div class="env" id="env">
    <div class="back"></div>
    <div class="letter"></div>
    <div class="front"></div>
    <div class="flap"></div>
    <div class="name script">Noor</div>
    <div class="seal">❤️</div>
  </div>
  <div class="hint">اضغطي لفتحه</div>
</section>

<main id="main">
  <div class="hero">
    <h1 class="script">Noor</h1>
    <div class="divider">♥ ♥ ♥</div>
    <p>إلى نور قلبي</p>
  </div>

  <div class="msg">
    هتفضلي حبي الأول والأخير، وأميرة قلبي، وحبيبتي، وروح قلبي 💖
  </div>

  <div class="counter">
    <div class="t">حبنا عايش من…</div>
    <div class="d">٣١ مارس ٢٠٢٦</div>
    <div class="units" id="units"></div>
    <div class="hh">♥</div>
  </div>

  <h2>ذكرياتنا ✨</h2>
  <div class="grid" id="grid">
<div class="frame"><div class="slot"><img draggable="false" alt="" src="data:image/jpeg;base64,"></div></div>
<div class="frame"><div class="slot"><img draggable="false" alt="" src="data:image/webp;base64,"></div></div>
<div class="frame"><div class="slot"><img draggable="false" alt="" src="data:image/jpeg;base64,"></div></div>
<div class="frame"><div class="slot"><img draggable="false" alt="" src="data:image/webp;base64,"></div></div>
<div class="frame"><div class="slot"><img draggable="false" alt="" src="data:image/jpeg;base64,"></div></div>
<div class="frame"><div class="slot"><img draggable="false" alt="" src="data:image/webp;base64,"></div></div>
<div class="frame"><div class="slot"><img draggable="false" alt="" src="data:image/jpeg;base64,"></div></div>
<div class="frame"><div class="slot"><img draggable="false" alt="" src="data:image/webp;base64,"></div></div>
</div>

  <div class="foot">من قلبي إلى نور حبيبتي ❤️</div>
</main>

<script>

const labels=['سنة','شهر','يوم','ساعة','دقيقة','ثانية'];
const uEl=document.getElementById('units');
labels.forEach(l=>{const d=document.createElement('div');d.className='u';d.innerHTML='<b>0</b><span>'+l+'</span>';uEl.appendChild(d)});
const start=new Date(2026,2,31,0,0,0);
function addMonths(d,n){const r=new Date(d.getFullYear(),d.getMonth()+n,1,d.getHours(),d.getMinutes(),d.getSeconds());
  const last=new Date(r.getFullYear(),r.getMonth()+1,0).getDate();r.setDate(Math.min(d.getDate(),last));return r}
function tick(){
  const now=new Date();if(now<start){return}
  let mo=(now.getFullYear()-start.getFullYear())*12+now.getMonth()-start.getMonth();
  if(addMonths(start,mo)>now)mo--;
  const rem=now-addMonths(start,mo);
  const v=[Math.floor(mo/12),mo%12,Math.floor(rem/864e5),Math.floor(rem/36e5)%24,Math.floor(rem/6e4)%60,Math.floor(rem/1e3)%60];
  uEl.querySelectorAll('b').forEach((b,i)=>b.textContent=v[i]);
}
tick();setInterval(tick,1000);
function spawn(){
  const h=document.createElement('div');h.className='heart-f';
  h.textContent=['♥','❤','💗','💕'][Math.random()*4|0];
  h.style.left=Math.random()*100+'%';h.style.fontSize=(12+Math.random()*22)+'px';
  h.style.animationDuration=(7+Math.random()*7)+'s';
  document.getElementById('hearts').appendChild(h);
  setTimeout(()=>h.remove(),15000);
}
setInterval(spawn,700);

document.getElementById('env').addEventListener('click',()=>{
  document.getElementById('env').classList.add('open');
  setTimeout(()=>{
    document.getElementById('intro').classList.add('gone');
    document.getElementById('main').classList.add('show');
    window.scrollTo(0,0);
    for(let i=0;i<20;i++)setTimeout(spawn,i*80);
  },1700);
},{once:true});
</script>
</body>
</html>
